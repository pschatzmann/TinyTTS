/**
 * Timing-only benchmark: no I2S/codec, no audio hardware needed at all --
 * just runs speak() with a no-op AudioChunkFn sink and reports the
 * built-in per-stage timing ([TinyTTS] encoder/duration_predictor/flow/
 * vocoder lines, always-on via TinyTTSCore.h's timingLog()) over Serial.
 * Matches the same benchmark methodology docs/performance.md used for the
 * ESP32-P4 measurement -- a real board, no display/audio peripheral
 * dependency, just synthesis timing.
 *
 * Board settings: PSRAM=opi, FlashSize=16M, PartitionScheme=custom (this
 * sketch's own partitions.csv), USBMode=hwcdc, CDCOnBoot=cdc.
 * ESP32-P4: PSRAM=enabled, FlashSize=16M, PartitionScheme=custom, and
 * ChipVariant=postv3 for v3.x silicon (esptool prints the revision; the
 * wrong variant boot-loops). CDCOnBoot depends on which USB port you use:
 * the board's USB-UART bridge (e.g. a CH343, shows up as "USB Single
 * Serial") needs CDCOnBoot=default so Serial is UART0; the chip's native
 * USB port needs USBMode=hwcdc, CDCOnBoot=cdc. With the wrong one the
 * sketch runs but prints nothing.
 *
 * Model: the released 44.1 kHz model (default_weights) by default; define
 * TINYTTS_BENCH_16K to benchmark the 16 kHz model trained with
 * research/training/ instead (ljspeech16k_weights, generated by
 * research/export_headers.py --weights ... --name ljspeech16k, see
 * docs/training.md). Both print the same per-stage timing plus the audio
 * length and real-time factor, so the two are directly comparable.
 */
// #define TINYTTS_BENCH_16K
#include "TinyTTS.h"
#ifdef TINYTTS_BENCH_16K
#include "TinyTTS/data/ljspeech16k_weights_data.h"
#define BENCH_WEIGHTS ljspeech16k_weights
#define BENCH_WEIGHTS_LEN ljspeech16k_weights_len
#else
#include "TinyTTS/data/default_weights_data.h"
#define BENCH_WEIGHTS default_weights
#define BENCH_WEIGHTS_LEN default_weights_len
#endif
#include "TinyTTS/data/default_cmudict_slim_data.h"
#include "TinyTTS/data/default_dictionary_model_data.h"

tinytts::TinyTTS tts;
size_t samples_out = 0;  // samples produced by the last speak()

void setup() {
  Serial.begin(115200);
  // Bounded wait: on the ESP32-P4 (core 3.3.x, hardware CDC) Serial never
  // reports a connected host, so an unbounded while (!Serial) hangs forever.
  for (uint32_t t0 = millis(); !Serial && millis() - t0 < 5000;) {}
  delay(2000);

#ifdef ESP32
  Serial.printf("PSRAM: %u bytes free of %u\n", ESP.getFreePsram(), ESP.getPsramSize());
#endif

  tts.setWeights(BENCH_WEIGHTS, BENCH_WEIGHTS_LEN);
  tts.setDictionary(default_cmudict_slim, default_cmudict_slim_len);
  tts.setDictionaryModel(default_dictionary_model, default_dictionary_model_len);
#ifdef TINYTTS_BENCH_INT8
  tts.setDecoderPrecision(tinytts::ops::DecoderPrecision::kInt8Activations);
#endif
  // INT8 is also the default when the Tang Nano 20K's AI accelerator is
  // enabled (TINYTTS_HAVE_TANG_AI, see Ops.h).
  if (tinytts::ops::decoderPrecision() == tinytts::ops::DecoderPrecision::kInt8Activations)
    Serial.println("Decoder precision: INT8 activations (per-row quant)");
  else
    Serial.println("Decoder precision: float32 (default)");
  // Tang Nano 20K with Tools > AI Accelerator enabled: linear(), float
  // conv1d() and convTranspose1d() also run on the engine (see Ops.h).
  Serial.println(tinytts::ops::accelerateFloatOps() ? "Float ops: INT8 on the AI accelerator" : "Float ops: float32");
  if (!tts.begin([](const float*, size_t count) { samples_out += count; /* discard: timing only */ })) {
    Serial.println("TinyTTS.begin() failed -- did you call all setters above?");
    while (true) {}
  }

#ifdef ESP32
  Serial.printf("PSRAM after begin(): %u bytes free of %u\n", ESP.getFreePsram(), ESP.getPsramSize());
#endif
  Serial.print("Model sample rate: ");
  Serial.print(tts.getAudioSampleRate());
  Serial.println(" Hz");
  Serial.println("Ready.");
}

void loop() {
  Serial.println("=== speak(\"Hello world!\") ===");
  samples_out = 0;
  uint32_t t0 = millis();
  tts.speak("Hello world!");
  uint32_t ms = millis() - t0;
  // Serial.print() rather than printf: not every core (e.g. Tang Nano 20K) has Serial.printf.
  unsigned long audio_ms = (unsigned long)((uint64_t)samples_out * 1000 / tts.getAudioSampleRate());
  Serial.print("total: ");
  Serial.print(ms);
  Serial.print(" ms for ");
  Serial.print(audio_ms);
  Serial.print(" ms of audio -> ");
  Serial.print(audio_ms ? (float)ms / audio_ms : 0.0f, 1);
  Serial.println("x real time");
  delay(2000);  // matches tts_i2s_output's own pattern -- avoids a task-watchdog reset on repeated back-to-back calls
}
